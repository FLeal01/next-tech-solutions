<div class="container-narrow">
  <div class="page-head">
    <h1>Crear cuenta</h1>
  </div>

  {{#if error}}<div class="alert alert-error">{{error}}</div>{{/if}}

  <div class="card">
    <div class="card-body">
      <form method="post" action="/registro">
        <div class="field">
          <label for="nombre">Nombre</label>
          <input class="input" id="nombre" name="nombre" autocomplete="name" value="{{valores.nombre}}" required />
        </div>
        <div class="field">
          <label for="correo">Correo</label>
          <input class="input" id="correo" name="correo" type="email" autocomplete="email" value="{{valores.correo}}" required />
        </div>
        <div class="field">
          <label for="clave">Clave</label>
          <div class="input-password">
            <input class="input{{#if errorClave}} input-invalid{{/if}}" id="clave" name="clave" type="password" minlength="8" autocomplete="new-password"{{#if errorClave}} aria-invalid="true" aria-describedby="clave-error"{{/if}} required />
            <button class="toggle-clave" type="button" data-toggle-clave aria-pressed="false" aria-label="Mostrar clave">Mostrar</button>
          </div>
          {{#if errorClave}}<p class="field-error" id="clave-error">{{errorClave}}</p>{{/if}}
          <ul class="clave-requisitos" aria-live="polite">
            <li data-req="largo">Mínimo 8 caracteres</li>
            <li data-req="minuscula">Al menos una minúscula</li>
            <li data-req="mayuscula">Al menos una mayúscula</li>
            <li data-req="numero">Al menos un número</li>
            <li data-req="simbolo">Al menos un símbolo especial</li>
          </ul>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Registrarse</button>
      </form>
    </div>
  </div>

  <p class="form-foot">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
</div>
